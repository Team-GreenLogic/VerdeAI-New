# VerdeAI Environment Configuration
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=                              # set per service (leave blank here)

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080                          # internal cluster URL
KEYCLOAK_PUBLIC_URL=http://localhost:8080                  # what end-user clients see
KEYCLOAK_REALM=verdeai
KEYCLOAK_FRONTEND_CLIENT_ID=verdeai-frontend               # public client
KEYCLOAK_ADMIN_CLIENT_ID=verdeai-admin                     # confidential client used by api-gateway
KEYCLOAK_ADMIN_CLIENT_SECRET=                              # set after first realm import (see README)
KEYCLOAK_ADMIN_USER=admin                                  # Keycloak bootstrap admin username
KEYCLOAK_ADMIN_PASSWORD=admin                              # Keycloak bootstrap admin password
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600
KEYCLOAK_TOKEN_LEEWAY_SECONDS=10                           # clock-skew tolerance for exp/nbf checks

# --- MongoDB ---
MONGO_URI=mongodb://mongodb:27017/?directConnection=true
MONGO_DB=verdeai
VECTOR_INDEX_NAME=chunks_vector_idx
ISO_VECTOR_INDEX_NAME=iso_clauses_vector_idx

# --- RabbitMQ ---
RABBITMQ_URL=amqp://verdeai:verdeai@rabbitmq:5672/

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenRouter (single LLM gateway for all completion calls) ---
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=https://verdeai.local
OPENROUTER_APP_NAME=VerdeAI
PRIMARY_REASONING_MODEL=deepseek/deepseek-v4-flash
CHEAP_REASONING_MODEL=meta-llama/llama-3.3-70b-instruct
VISION_MODEL=mistralai/mistral-small-3.1-24b-instruct
LLM_MAX_RETRIES=3

# --- Voyage AI (embeddings + reranking) ---
# Get your key at https://www.voyageai.com
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_RERANKER_MODEL=rerank-2.5
EMBEDDING_DIMENSIONS=1024

# --- LlamaParse (document parsing) ---
# Get your key at https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=agentic

# --- Tavily (web search for ISO seeding — optional) ---
# Get your key at https://tavily.com
TAVILY_API_KEY=

# --- Observability (self-hosted Langfuse) ---
# These match the LANGFUSE_INIT_* values in docker-compose.yml — do not change for local dev.
LANGFUSE_SECRET_KEY=sk-lf-local-verdeai
LANGFUSE_PUBLIC_KEY=pk-lf-local-verdeai
LANGFUSE_BASE_URL=http://langfuse:3000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# --- Service URLs (intra-cluster) ---
CHAT_RAG_URL=http://chat-rag:8001

# --- Retrieval Tuning ---
EMBED_BATCH_SIZE=128
RETRIEVAL_TOP_K=30
RERANK_TOP_K=8
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

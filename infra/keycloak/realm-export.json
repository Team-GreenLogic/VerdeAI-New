{
  "id": "verdeai",
  "realm": "verdeai",
  "displayName": "VerdeAI",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 1800,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "id": "compliance-officer-role-id",
        "name": "compliance-officer",
        "description": "Default role for end users",
        "composite": false,
        "clientRole": false,
        "containerId": "verdeai"
      },
      {
        "id": "tenant-admin-role-id",
        "name": "tenant-admin",
        "description": "Can invite additional users into the same tenant",
        "composite": false,
        "clientRole": false,
        "containerId": "verdeai"
      }
    ]
  },
  "clients": [
    {
      "id": "verdeai-frontend-client-id",
      "clientId": "verdeai-frontend",
      "name": "VerdeAI Frontend",
      "description": "Public client for browser/mobile/CLI authentication",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:*/*",
        "https://verdeai.local/*"
      ],
      "webOrigins": [
        "http://localhost:*",
        "https://verdeai.local"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "id": "tenant-id-mapper-id",
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "id": "verdeai-admin-client-id",
      "clientId": "verdeai-admin",
      "name": "VerdeAI Admin",
      "description": "Confidential client used by api-gateway to call Keycloak Admin API",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "verdeai-admin-secret-change-me",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopeMappings": {
    "verdeai-admin": [
      {
        "client": "realm-management",
        "roles": ["manage-users", "view-users"]
      }
    ]
  },
  "users": [
    {
      "id": "seed-admin-user-id",
      "username": "admin@verdeai.local",
      "email": "admin@verdeai.local",
      "firstName": "Admin",
      "lastName": "VerdeAI",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "changeme",
          "temporary": false
        }
      ],
      "realmRoles": ["compliance-officer", "default-roles-verdeai"],
      "attributes": {
        "tenant_id": ["00000000-0000-0000-0000-000000000001"]
      }
    }
  ],
  "defaultRoles": ["offline_access", "uma_authorization"],
  "requiredCredentials": ["password"],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "smtpServer": {},
  "eventsEnabled": false,
  "adminEventsEnabled": false,
  "internationalizationEnabled": false,
  "supportedLocales": [],
  "defaultLocale": "en",
  "authenticationFlows": [],
  "authenticatorConfig": [],
  "identityProviders": [],
  "identityProviderMappers": [],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "id": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID\",\"validations\":{},\"annotations\":{},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Compliance Report — {{ org.name or "Organisation" }}</title>
<style>
  @page {
    size: A4;
    margin: 20mm 16mm 18mm 16mm;
    @bottom-left {
      content: "{{ org.name or 'Compliance Report' }}";
      font-size: 8pt;
      color: #94a3b8;
    }
    @bottom-center {
      content: "Generated by VerdeAI";
      font-size: 8pt;
      color: #94a3b8;
    }
    @bottom-right {
      content: "Page " counter(page) " of " counter(pages);
      font-size: 8pt;
      color: #94a3b8;
    }
  }
  @page cover { margin: 0; @bottom-left { content: ""; } @bottom-center { content: ""; } @bottom-right { content: ""; } }

  * { box-sizing: border-box; }
  body {
    font-family: "DejaVu Sans", "Helvetica Neue", Arial, sans-serif;
    color: #1e293b;
    font-size: 10pt;
    line-height: 1.5;
    margin: 0;
  }
  h1, h2, h3, h4 { color: #0f172a; margin: 0; }
  p { margin: 0 0 6px 0; }

  /* ---- Cover ---- */
  .cover {
    page: cover;
    height: 297mm;
    padding: 40mm 24mm;
    background: linear-gradient(160deg, #064e3b 0%, #047857 55%, #10b981 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .cover .eyebrow { font-size: 11pt; letter-spacing: 3px; text-transform: uppercase; opacity: 0.85; }
  .cover .org { font-size: 34pt; font-weight: 700; margin-top: 6mm; line-height: 1.1; }
  .cover .title { font-size: 17pt; font-weight: 400; margin-top: 10mm; opacity: 0.95; }
  .cover .standard { font-size: 12pt; margin-top: 3mm; opacity: 0.9; }
  .cover .meta { font-size: 10pt; opacity: 0.85; }
  .cover .meta strong { font-weight: 700; }
  .cover .brand { font-size: 10pt; letter-spacing: 1px; opacity: 0.9; }
  .cover .rule { width: 60mm; height: 2px; background: rgba(255,255,255,0.6); margin: 8mm 0; }

  /* ---- Sections ---- */
  section { page-break-inside: auto; }
  .section-break { page-break-before: always; }
  h2.section-title {
    font-size: 15pt;
    border-bottom: 2px solid #047857;
    padding-bottom: 4px;
    margin-bottom: 10px;
    color: #065f46;
  }
  h3.sub { font-size: 11pt; color: #334155; margin: 14px 0 6px; }

  /* ---- Score / summary (table layout — WeasyPrint-safe, avoids flex gap issues) ---- */
  .score-row { display: table; width: 100%; margin: 12px 0 6px; border-collapse: separate; }
  .score-card {
    display: table-cell;
    width: 44mm;
    vertical-align: middle;
    border: 1px solid #d1fae5;
    background: #ecfdf5;
    border-radius: 8px;
    padding: 14px 12px;
    text-align: center;
  }
  .score-card .num { font-size: 30pt; font-weight: 700; color: #047857; line-height: 1; }
  .score-card .lbl { font-size: 8.5pt; color: #059669; margin-top: 5px; text-transform: uppercase; letter-spacing: 1px; }
  .score-gap { display: table-cell; width: 8mm; }
  .summary-text { display: table-cell; vertical-align: middle; font-size: 10pt; color: #334155; }

  .rag-bar { display: flex; height: 14px; border-radius: 7px; overflow: hidden; margin: 10px 0 6px; background: #f1f5f9; }
  .rag-bar .seg-met { background: #10b981; }
  .rag-bar .seg-partial { background: #f59e0b; }
  .rag-bar .seg-notmet { background: #ef4444; }
  .rag-bar .seg-insufficient { background: #cbd5e1; }

  .legend { font-size: 9pt; color: #475569; }
  .legend span { margin-right: 14px; white-space: nowrap; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
  .dot-met { background: #10b981; } .dot-partial { background: #f59e0b; }
  .dot-notmet { background: #ef4444; } .dot-insufficient { background: #cbd5e1; }

  /* ---- Org profile block ---- */
  table.kv { width: 100%; border-collapse: collapse; margin-top: 6px; }
  table.kv td { padding: 4px 8px; vertical-align: top; font-size: 9.5pt; border-bottom: 1px solid #f1f5f9; }
  table.kv td.k { width: 40mm; color: #64748b; font-weight: 600; }

  /* ---- Findings table ---- */
  table.findings { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 9pt; }
  table.findings th {
    background: #065f46; color: #fff; text-align: left; padding: 6px 8px; font-size: 8.5pt;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  table.findings td { padding: 6px 8px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
  table.findings tr { page-break-inside: avoid; }
  .clause-id { font-family: "DejaVu Sans Mono", monospace; font-weight: 700; color: #334155; }
  .status-pill {
    display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 8pt; font-weight: 700;
    white-space: nowrap;
  }
  .met { background: #d1fae5; color: #065f46; }
  .partial { background: #fef3c7; color: #92400e; }
  .notmet { background: #fee2e2; color: #991b1b; }
  .insufficient { background: #f1f5f9; color: #475569; }
  .other { background: #f1f5f9; color: #475569; }

  /* ---- Detailed findings ---- */
  .finding {
    border: 1px solid #e2e8f0; border-left: 4px solid #cbd5e1; border-radius: 6px;
    padding: 10px 12px; margin-bottom: 10px; page-break-inside: avoid;
  }
  .finding.met { border-left-color: #10b981; }
  .finding.partial { border-left-color: #f59e0b; }
  .finding.notmet { border-left-color: #ef4444; }
  .finding.insufficient { border-left-color: #cbd5e1; }
  .finding .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .finding .head .name { font-size: 10.5pt; font-weight: 700; color: #0f172a; }
  .label { font-size: 8pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin: 8px 0 3px; }
  ul.tight { margin: 2px 0 0 0; padding-left: 16px; }
  ul.tight li { margin-bottom: 2px; }
  .miss li { color: #b91c1c; }
  .cites .cite { font-size: 8.5pt; color: #475569; margin-bottom: 4px; }
  .cites .cite .src { font-weight: 700; color: #334155; }
  .cites .cite table { width: 100%; border-collapse: collapse; margin: 4px 0; font-size: 8pt; }
  .cites .cite th, .cites .cite td { border: 1px solid #e2e8f0; padding: 2px 4px; text-align: left; }
  .cites .cite th { background: #f8fafc; font-weight: 700; }

  /* ---- Recommendations / missing info ---- */
  .rec { border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 10px; margin-bottom: 8px; page-break-inside: avoid; }
  .rec .metrics { font-size: 8.5pt; color: #475569; margin-top: 4px; }
  .rec .metrics span { margin-right: 14px; }
  .stars { letter-spacing: 1px; }
  .stars.cost { color: #ef4444; } .stars.impact { color: #059669; }
  .clause-group-title { font-size: 9pt; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin: 12px 0 4px; }
  .field-path { font-family: "DejaVu Sans Mono", monospace; font-size: 8.5pt; color: #047857; }
  .muted { color: #94a3b8; font-style: italic; }
</style>
</head>
<body>

<!-- ============ COVER ============ -->
<div class="cover">
  <div>
    <div class="eyebrow">Compliance Gap Analysis Report</div>
    <div class="org">{{ org.name or "Organisation Compliance Report" }}</div>
    <div class="rule"></div>
    <div class="title">{{ standard.name }}</div>
    {% if standard.description %}<div class="standard">{{ standard.description }}</div>{% endif %}
  </div>
  <div>
    <div class="meta"><strong>Analysis date:</strong> {{ analysis.created_at }}</div>
    <div class="meta"><strong>Report generated:</strong> {{ generated_at }}</div>
    <div class="meta"><strong>Reference:</strong> {{ analysis.short_id }}</div>
    <div class="rule"></div>
    <div class="brand">Generated by VerdeAI</div>
  </div>
</div>

<!-- ============ EXECUTIVE SUMMARY ============ -->
<section>
  <h2 class="section-title">Executive Summary</h2>
  <div class="score-row">
    <div class="score-card">
      <div class="num">{{ summary.score }}%</div>
      <div class="lbl">Compliance Score</div>
    </div>
    <div class="score-gap"></div>
    <div class="summary-text">
      <p>
        This report presents the results of an AI-assisted compliance gap analysis of
        <strong>{{ org.name or "the organisation" }}</strong> against <strong>{{ standard.name }}</strong>.
        Of the <strong>{{ summary.total }}</strong> clauses assessed,
        <strong>{{ summary.met }}</strong> are fully met, giving an overall compliance score of
        <strong>{{ summary.score }}% ({{ summary.score_label }})</strong>.
        <strong>{{ summary.gap_count }}</strong> clause{{ "" if summary.gap_count == 1 else "s" }}
        require{{ "s" if summary.gap_count == 1 else "" }} attention.
      </p>
    </div>
  </div>

  <div class="rag-bar">
    {% if summary.total %}
    {% if summary.met %}<div class="seg-met" style="width: {{ (summary.met / summary.total * 100) }}%"></div>{% endif %}
    {% if summary.partially_met %}<div class="seg-partial" style="width: {{ (summary.partially_met / summary.total * 100) }}%"></div>{% endif %}
    {% if summary.not_met %}<div class="seg-notmet" style="width: {{ (summary.not_met / summary.total * 100) }}%"></div>{% endif %}
    {% if summary.insufficient or summary.other %}<div class="seg-insufficient" style="width: {{ ((summary.insufficient + summary.other) / summary.total * 100) }}%"></div>{% endif %}
    {% endif %}
  </div>
  <div class="legend">
    <span><span class="dot dot-met"></span>{{ summary.met }} Met</span>
    <span><span class="dot dot-partial"></span>{{ summary.partially_met }} Partially Met</span>
    <span><span class="dot dot-notmet"></span>{{ summary.not_met }} Not Met</span>
    <span><span class="dot dot-insufficient"></span>{{ summary.insufficient + summary.other }} Insufficient Evidence</span>
  </div>

  <h3 class="sub">Organisation Profile</h3>
  <table class="kv">
    <tr><td class="k">Organisation</td><td>{{ org.name or "—" }}</td></tr>
    <tr><td class="k">Industry</td><td>{{ org.industry or "—" }}</td></tr>
    <tr><td class="k">Size</td><td>{{ org.size or "—" }}</td></tr>
    <tr><td class="k">Location</td><td>{{ org.location or "—" }}</td></tr>
    {% if org.description %}<tr><td class="k">Description</td><td>{{ org.description }}</td></tr>{% endif %}
  </table>

  <h3 class="sub">Scope &amp; Methodology</h3>
  <p>
    This assessment evaluated the organisation's documented management system against the
    {{ summary.total }} clauses of {{ standard.name }}. Each clause was analysed individually by
    VerdeAI's AI pipeline, which retrieves relevant evidence from the organisation's uploaded
    documents and profile, compares it against the clause requirements, and classifies the clause
    as <em>Met</em>, <em>Partially Met</em>, <em>Not Met</em>, or <em>Insufficient Evidence</em>.
    Findings, cited evidence, and recommended remediation actions are detailed in the following sections.
  </p>
</section>

<!-- ============ FINDINGS TABLE ============ -->
<section class="section-break">
  <h2 class="section-title">Clause-by-Clause Findings</h2>
  <table class="findings">
    <thead>
      <tr>
        <th style="width: 16mm;">Clause</th>
        <th>Requirement</th>
        <th style="width: 30mm;">Status</th>
      </tr>
    </thead>
    <tbody>
      {% for c in clauses %}
      <tr>
        <td class="clause-id">{{ c.clause_id }}</td>
        <td>{{ c.title }}</td>
        <td><span class="status-pill {{ c.decision_class }}">{{ c.decision }}</span></td>
      </tr>
      {% else %}
      <tr><td colspan="3" class="muted">No clause results available.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<!-- ============ DETAILED FINDINGS ============ -->
<section class="section-break">
  <h2 class="section-title">Detailed Findings</h2>
  {% for c in clauses %}
  <div class="finding {{ c.decision_class }}">
    <div class="head">
      <span class="name"><span class="clause-id">{{ c.clause_id }}</span> &nbsp;{{ c.title }}</span>
      <span class="status-pill {{ c.decision_class }}">{{ c.decision }}</span>
    </div>
    {% if c.reasoning %}
    <div class="label">Assessment</div>
    <p>{{ c.reasoning }}</p>
    {% endif %}
    {% if c.missing_evidence %}
    <div class="label">Missing Evidence</div>
    <ul class="tight miss">
      {% for m in c.missing_evidence %}<li>{{ m }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if c.citations %}
    <div class="label">Evidence &amp; Citations</div>
    <div class="cites">
      {% for cite in c.citations %}
      <div class="cite"><span class="src">{{ cite.label }}</span>{% if cite.html %} — {{ cite.html|safe }}{% endif %}</div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% else %}
  <p class="muted">No detailed findings available.</p>
  {% endfor %}
</section>

<!-- ============ RECOMMENDATIONS ============ -->
<section class="section-break">
  <h2 class="section-title">Recommendations</h2>
  {% for c in clauses_with_recs %}
  <div class="clause-group-title">Clause {{ c.clause_id }} — {{ c.title }}</div>
  {% for rec in c.recommendations %}
  <div class="rec">
    <p>{{ rec.text }}</p>
    <div class="metrics">
      <span>Cost: <span class="stars cost">{{ "★" * rec.cost }}{{ "☆" * (5 - rec.cost) }}</span></span>
      <span>Impact: <span class="stars impact">{{ "★" * rec.impact }}{{ "☆" * (5 - rec.impact) }}</span></span>
      <span>Effort: <strong>{{ rec.effort_weeks }}w</strong></span>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <p class="muted">No recommendations were generated for this analysis.</p>
  {% endfor %}
</section>

<!-- ============ MISSING INFORMATION ============ -->
<section class="section-break">
  <h2 class="section-title">Missing Information Requests</h2>
  <p>The following information should be gathered to close outstanding evidence gaps.</p>
  {% for c in clauses_with_missing %}
  <div class="clause-group-title">Clause {{ c.clause_id }} — {{ c.title }}</div>
  {% for req in c.missing_requirements %}
  <div class="rec">
    <div class="field-path">{{ req.field_path }}</div>
    <p>{{ req.request_text }}</p>
  </div>
  {% endfor %}
  {% else %}
  <p class="muted">No missing-information requests were generated for this analysis.</p>
  {% endfor %}
</section>

</body>
</html>
